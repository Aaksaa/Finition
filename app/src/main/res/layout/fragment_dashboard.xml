<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Overdue alert banner -->
        <LinearLayout
            android:id="@+id/overdue_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alert_accent"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/touch_target"
            android:orientation="vertical"
            android:padding="@dimen/space_lg"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_overdue"
                android:textAppearance="@style/TextAppearance.Finition.MonoLabel"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/overdue_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Finition.BodySm"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- Unbilled income banner -->
        <LinearLayout
            android:id="@+id/unbilled_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/touch_target"
            android:orientation="vertical"
            android:padding="@dimen/space_lg"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invoice_create"
                android:textAppearance="@style/TextAppearance.Finition.MonoLabel"
                android:textColor="@color/badge_info" />

            <TextView
                android:id="@+id/unbilled_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Finition.BodySm"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- Summary cards: income / expenses / net -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_total_income"
                    android:textAppearance="@style/TextAppearance.Finition.MonoLabel" />

                <TextView
                    android:id="@+id/total_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Finition.Title"
                    android:textColor="@color/badge_success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_total_expenses"
                    android:textAppearance="@style/TextAppearance.Finition.MonoLabel" />

                <TextView
                    android:id="@+id/total_expenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Finition.Title"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Net profit feature card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_net_profit"
                android:textAppearance="@style/TextAppearance.Finition.MonoLabel" />

            <TextView
                android:id="@+id/net_profit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Finition.Display" />
        </LinearLayout>

        <!-- Cash flow chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_cash_flow"
                android:textAppearance="@style/TextAppearance.Finition.MonoLabel" />

            <com.finition.app.ui.dashboard.CashFlowChartView
                android:id="@+id/cash_flow_chart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/space_lg" />
        </LinearLayout>

        <!-- Expense breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_expense_breakdown"
                android:textAppearance="@style/TextAppearance.Finition.MonoLabel" />

            <TextView
                android:id="@+id/expense_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/dashboard_no_expenses"
                android:textAppearance="@style/TextAppearance.Finition.BodySm"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/expense_breakdown_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
