<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= Typography (Sanity: Space Grotesk + IBM Plex Mono) ================= -->

    <style name="TextAppearance.Finition.Display" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Finition.HeadingMd" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.24</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Finition.Title" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Finition.Body" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/on_dark_mute</item>
    </style>

    <style name="TextAppearance.Finition.BodySm" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/on_dark_mute</item>
    </style>

    <style name="TextAppearance.Finition.Caption" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/ash</item>
    </style>

    <!-- IBM Plex Mono uppercase "system readout" labels -->
    <style name="TextAppearance.Finition.MonoLabel" parent="">
        <item name="android:fontFamily">@font/ibm_plex_mono</item>
        <item name="fontFamily">@font/ibm_plex_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.045</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ash</item>
    </style>

    <!-- Monospace numeric readout (amounts, invoice numbers) -->
    <style name="TextAppearance.Finition.MonoAmount" parent="">
        <item name="android:fontFamily">@font/ibm_plex_mono</item>
        <item name="fontFamily">@font/ibm_plex_mono</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Finition.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
    </style>

    <!-- ================= Buttons ================= -->
    <!-- Primary: full-pill coral CTA; pressed state shifts to electric blue (activation signal) -->

    <style name="Widget.Finition.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.Finition.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/on_dark_mute</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.Finition.Button.Ghost" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/on_dark_mute</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Danger action: coral pill with hairline, used for destructive ops -->
    <style name="Widget.Finition.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- ================= Inputs ================= -->

    <style name="Widget.Finition.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ash</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
    </style>

    <!-- ================= Cards ================= -->

    <style name="Widget.Finition.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- ================= Filter tabs (pill radios, mono uppercase) ================= -->

    <style name="Widget.Finition.TabPill" parent="">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_tab_pill</item>
        <item name="android:textColor">@color/selector_tab_text</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.045</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/ibm_plex_mono</item>
        <item name="fontFamily">@font/ibm_plex_mono</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ================= Bottom navigation ================= -->

    <style name="Widget.Finition.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Finition.MonoLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Finition.MonoLabel</item>
        <item name="itemRippleColor">@color/secondary</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ================= FAB ================= -->

    <style name="Widget.Finition.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Finition.Pill</item>
        <item name="rippleColor">@color/secondary</item>
    </style>

    <style name="ShapeAppearance.Finition.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
